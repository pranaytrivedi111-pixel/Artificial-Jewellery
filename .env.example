# or set YOUPI_API_URL to connect to an external self-hosted YouPI-PG payment-api instance.
YOUPI_API_URL=
YOUPI_MERCHANT_ID=
YOUPI_MERCHANT_API_KEY=
YOUPI_WEBHOOK_SECRET=
YOUPI_PAYEE_VPA=
YOUPI_PAYEE_NAME=
YOUPI_ALLOWED_RETURN_ORIGINS=
YOUPI_ADMIN_PASSCODE=

